CITYPULSE_CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CITYPULSE_REDIS_STATE_URL=redis://127.0.0.1:6379/1
CITYPULSE_CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
CITYPULSE_REDIS_KEY_PREFIX=citypulse
CITYPULSE_SUMO_WORKER_CONCURRENCY=4
CITYPULSE_SESSION_TTL_SECONDS=86400
CITYPULSE_COMMAND_TIMEOUT_SECONDS=30
CITYPULSE_WORKER_HEARTBEAT_SECONDS=5
CITYPULSE_WORKER_HEARTBEAT_TTL_SECONDS=15

# Override these only when the generated data or output directory is elsewhere.
# CITYPULSE_SUMO_GENERATED_DIR=/path/to/data/maps/sumo/generated
# CITYPULSE_SUMO_SESSION_ROOT=/path/to/outputs/sessions
