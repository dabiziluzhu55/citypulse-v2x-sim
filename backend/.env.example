APP_NAME=CityPulse V2X Backend
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false

FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

SUMO_HOME=/usr/share/sumo
SUMO_GENERATED_DIR=data/maps/sumo/generated
SUMO_SESSION_ROOT=outputs/sessions

# 仿真管理器：local=本机单进程 SimulationManager；redis=RedisSimulationManager 多会话
SIMULATION_MANAGER_MODE=local

# redis模式（与SUMO Celery worker共享）
CITYPULSE_REDIS_STATE_URL=redis://127.0.0.1:6380/1
CITYPULSE_REDIS_KEY_PREFIX=citypulse
CITYPULSE_SESSION_TTL_SECONDS=86400
CITYPULSE_COMMAND_TIMEOUT_SECONDS=30
CITYPULSE_WORKER_HEARTBEAT_TTL_SECONDS=15

DEFAULT_INTERSECTION_ID=demo_2
DEFAULT_MAP_RADIUS_METERS=600
DEFAULT_SNAPSHOT_INTERVAL_SECONDS=0.2

# SUMO worker回调本进程内部算法协议的基址（多机部署时不要使用 127.0.0.1）
# 实际路径形如：{ALGORITHM_BASE_URL}/api/v1/internal/algorithm/{control_mode}
# 注意：AlgorithmRuntimeStore 为进程内状态，Uvicorn 请使用 --workers 1
ALGORITHM_BASE_URL=http://127.0.0.1:8000
ALGORITHM_TIMEOUT=2.0
DECISION_INTERVAL=5.0

# 事件识别与短时预测（backend进程内，按仿真时间采样）
INTELLIGENCE_SAMPLE_SECONDS=5.0
INTELLIGENCE_HISTORY_FRAMES=12
PREDICTION_HORIZON_SECONDS=60.0
# NarrowNet-TDP运行时包（相对仓库根目录）；留空则交通预测模型会选择moving_average
PREDICTION_MODEL_DIR=backend/models/prediction/narrow_net_tdp

# Traffic Copilot：Qwen 服务建议只监听 GPU 服务器内网或回环地址
# 本地开发可通过 SSH -L 把远端 18000 映射到这里；不要直接暴露推理端口到公网
CITYPULSE_QWEN_BASE_URL=http://127.0.0.1:18000/v1
CITYPULSE_QWEN_MODEL=Qwen/Qwen2.5-7B-Instruct
CITYPULSE_QWEN_API_KEY=
CITYPULSE_QWEN_TIMEOUT_SECONDS=60
CITYPULSE_QWEN_TEMPERATURE=0.2
CITYPULSE_QWEN_MAX_TOKENS=512
COPILOT_MAX_ROUNDS=4
COPILOT_MAX_TOOL_CALLS=8
COPILOT_MAX_TOOL_RESULT_CHARS=20000

# 历史交通数据查询边界；生产 redis 模式将历史写入 Redis Streams
HISTORY_DEFAULT_LOOKBACK_SECONDS=300
HISTORY_MAX_QUERY_SECONDS=3600
HISTORY_MAX_POINTS=120

# Traffic knowledge RAG：先运行 scripts/rag/build_knowledge_index.py 构建索引
RAG_INDEX_DIR=outputs/rag/chroma
RAG_KNOWLEDGE_MANIFEST=traffic_knowledge/manifest.json
RAG_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# 建议部署时填写服务器本地模型目录，避免请求时联网下载
RAG_EMBEDDING_MODEL_PATH=
RAG_EMBEDDING_DEVICE=auto
RAG_COLLECTION_NAME=citypulse_traffic_knowledge
RAG_QUERY_INSTRUCTION=Given a traffic control or traffic engineering question, retrieve relevant passages that help answer the question.
RAG_TOP_K=5
RAG_QUERY_TIMEOUT_SECONDS=30

# 事件级 AI 信号接管：仅启动仿真时 disturbance_targets.ai_control_enabled=true 生效
AI_CONTROL_PLAN_VALID_SECONDS=30
AI_CONTROL_SLOT_SECONDS=5
AI_CONTROL_REPLAN_SECONDS=30
AI_CONTROL_RECOVERY_SECONDS=60
AI_CONTROL_RECOVERY_CLEAR_SAMPLES=3
AI_CONTROL_SCOPE_HOPS=1
AI_CONTROL_MAX_PLAN_FAILURES=2
