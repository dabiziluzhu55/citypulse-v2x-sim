APP_NAME=CityPulse V2X Backend
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false

FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

SUMO_HOME=/usr/share/sumo
SUMO_GENERATED_DIR=data/maps/sumo/generated
SUMO_SESSION_ROOT=outputs/sessions

# 仿真管理器：local=本机单进程 SimulationManager；redis=RedisSimulationManager 多会话
SIMULATION_MANAGER_MODE=local

# redis模式（与SUMO Celery worker共享）
CITYPULSE_REDIS_STATE_URL=redis://127.0.0.1:6380/1
CITYPULSE_REDIS_KEY_PREFIX=citypulse
CITYPULSE_SESSION_TTL_SECONDS=86400
CITYPULSE_COMMAND_TIMEOUT_SECONDS=30
CITYPULSE_WORKER_HEARTBEAT_TTL_SECONDS=15

DEFAULT_INTERSECTION_ID=demo_2
DEFAULT_MAP_RADIUS_METERS=600
DEFAULT_SNAPSHOT_INTERVAL_SECONDS=0.2

# SUMO worker回调本进程内部算法协议的基址（多机部署时不要使用 127.0.0.1）
# 实际路径形如：{ALGORITHM_BASE_URL}/api/v1/internal/algorithm/{control_mode}
# 注意：AlgorithmRuntimeStore 为进程内状态，Uvicorn 请使用 --workers 1
ALGORITHM_BASE_URL=http://127.0.0.1:8000
ALGORITHM_TIMEOUT=2.0
DECISION_INTERVAL=5.0

# 事件识别与短时预测（backend进程内，按仿真时间采样）
INTELLIGENCE_SAMPLE_SECONDS=5.0
INTELLIGENCE_HISTORY_FRAMES=12
PREDICTION_HORIZON_SECONDS=60.0
# NarrowNet-TDP运行时包（相对仓库根目录）；留空则交通预测模型会选择moving_average
PREDICTION_MODEL_DIR=backend/models/prediction/narrow_net_tdp
