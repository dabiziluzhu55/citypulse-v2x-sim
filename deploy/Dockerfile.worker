# Build Python dependencies separately; match the existing Ubuntu SUMO binary below.
FROM python:3.10-slim AS python-deps
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONNOUSERSITE=1 PYTHONPATH=/app \
    OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
COPY requirements.txt /tmp/worker-requirements.txt
COPY deploy/requirements/runtime-constraints.txt /tmp/runtime-constraints.txt
RUN pip install --no-cache-dir torch==2.13.0 --index-url https://download.pytorch.org/whl/cpu --extra-index-url https://pypi.org/simple \
    && pip install --no-cache-dir -c /tmp/runtime-constraints.txt -r /tmp/worker-requirements.txt \
       libsumo==1.12.0 sumolib==1.12.0 traci==1.12.0 pyproj==3.7.1
FROM ubuntu:22.04
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONNOUSERSITE=1 \
    PYTHONPATH=/app:/usr/lib/python3.10/site-packages:/opt/python \
    OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
RUN apt-get update -o Acquire::Retries=3 \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
       python3 ca-certificates sumo=1.12.0+dfsg1-1 sumo-tools=1.12.0+dfsg1-1 \
    && ln -s /usr/bin/python3 /usr/local/bin/python \
    && rm -rf /var/lib/apt/lists/*
COPY --from=python-deps /usr/local/lib/python3.10/site-packages /opt/python
# The PyPI wheel links an older PROJ; use Ubuntu's libsumo linked to system PROJ.
RUN rm -rf /opt/python/libsumo /opt/python/libsumo.libs
COPY simulation /app/simulation
COPY scenario_catalog /app/scenario_catalog
COPY simulation_protocol /app/simulation_protocol
COPY traffic_control /app/traffic_control
COPY traffic_eval /app/traffic_eval
COPY traffic_intelligence /app/traffic_intelligence
COPY traffic_llm_runtime /app/traffic_llm_runtime
RUN python -c "import libsumo, sumolib; print(libsumo.getVersion())"
CMD ["python", "-m", "celery", "-A", "simulation.sumo.engine.distributed.celery_app:app", "worker", "--queues", "citypulse-sumo", "--pool", "prefork", "--concurrency", "4", "--loglevel", "INFO"]
