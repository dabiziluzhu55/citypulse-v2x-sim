SIMULATION_MANAGER_MODE=redis
CITYPULSE_ENV_FILE=
CITYPULSE_SECRETS_DIR=/run/secrets
CITYPULSE_CELERY_BROKER_URL=redis://redis:6379/0
CITYPULSE_REDIS_STATE_URL=redis://redis:6379/1
CITYPULSE_CELERY_RESULT_BACKEND=redis://redis:6379/2
CITYPULSE_REDIS_KEY_PREFIX=citypulse-deploy
SUMO_GENERATED_DIR=/app/data/maps/sumo/generated
SUMO_SESSION_ROOT=/app/outputs/sessions
ALGORITHM_BASE_URL=http://backend:8000
CITYPULSE_LLM_BASE_URL=http://citypulse-qwen:8001/v1
CITYPULSE_LLM_MODEL=traffic-qwen-v2
RAG_EMBEDDING_DEVICE=cpu
# Mount local model and index paths and set RAG_EMBEDDING_MODEL_PATH/RAG_INDEX_DIR.
# Mount /run/secrets/citypulse_llm_api_key for server-side authentication.
# Never copy server authentication values into browser.env or runtime-config.js.
