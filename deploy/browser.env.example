# Public browser keys. Copy to deploy/local/browser.env; never commit real values.
# Inject at container startup, NOT with Docker build arguments.
CITYPULSE_BROWSER_BAIDU_AK=
CITYPULSE_BROWSER_TIANDITU_TOKEN=
CITYPULSE_BROWSER_CARTO_KEY=
CITYPULSE_BROWSER_AMAP_KEY=
# Alternatively mount a file and set CITYPULSE_BROWSER_BAIDU_AK_FILE=/run/secrets/baidu_browser_ak
