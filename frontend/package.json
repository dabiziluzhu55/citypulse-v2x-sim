  "dependencies": {
    "@baidumap/mapv-three": "^1.6.4",
    "cesium": "^1.131.0",
    "echarts": "^5.6.0",
    "element-plus": "^2.10.4",
    "jszip": "^3.10.1",
    "ol": "^10.6.1",
    "three": "^0.180.0",
    "vue": "^3.5.17",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "@types/node": "^24.0.13",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "fast-xml-parser": "^5.10.1",
    "meshoptimizer": "^1.2.0",
    "polygon-clipping": "^0.15.7",
    "sharp": "^0.35.3",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vite-plugin-cesium": "^1.2.23",
    "vue-tsc": "^3.0.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
