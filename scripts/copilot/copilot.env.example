# Copy this file to scripts/copilot/copilot.env on the target server.
# The copied file is ignored by Git because it contains machine-local paths.

# School server environment currently used for the dedicated CityPulse runtime.
CITYPULSE_PYTHON=/home/kemove/anaconda3/envs/v2x-ai-py310/bin/python
CITYPULSE_QWEN_PYTHON=/home/kemove/anaconda3/envs/v2x-ai-py310/bin/python
CUDA_VISIBLE_DEVICES=1
SUMO_HOME=/usr/share/sumo

# Model weights are not stored in Git.
CITYPULSE_QWEN_MODEL_PATH=/home/kemove/devdata1/zyh_v2x_ai/models/Qwen2.5-7B-Instruct
RAG_EMBEDDING_MODEL_PATH=/home/kemove/devdata1/zyh_v2x_ai/deploy/models/Qwen3-Embedding-0.6B

# The traffic index is generated inside the checked-out project; the standards
# index and its source manifest are the separately maintained server artifacts.
RAG_INDEX_DIR=outputs/rag/traffic_knowledge_chroma
RAG_KNOWLEDGE_MANIFEST=traffic_knowledge/manifest.json
RAG_KNOWLEDGE_CHUNKS=traffic_knowledge/build/chunks.jsonl
RAG_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
RAG_EMBEDDING_DEVICE=cpu
RAG_COLLECTION_NAME=citypulse_traffic_knowledge
RAG_STANDARDS_INDEX_DIR=/home/kemove/devdata1/zyh_v2x_ai/outputs/rag/standards_policy_chroma
RAG_STANDARDS_MANIFEST=/home/kemove/devdata1/zyh_v2x_ai/outputs/rag_build_20260903_main_8efb0c5/source/standards/rag_manifest.json
RAG_STANDARDS_CHUNKS=/home/kemove/devdata1/zyh_v2x_ai/outputs/rag_build_20260903_main_8efb0c5/source/standards/chunks.jsonl
RAG_STANDARDS_COLLECTION_NAME=citypulse_standards_policy

# Both services bind to loopback.  Use an SSH tunnel when access from a laptop
# or another host is needed; do not expose Qwen's port directly to the public net.
CITYPULSE_QWEN_HOST=127.0.0.1
CITYPULSE_QWEN_PORT=18000
CITYPULSE_QWEN_BASE_URL=http://127.0.0.1:18000/v1
CITYPULSE_QWEN_MODEL=Qwen/Qwen2.5-7B-Instruct
CITYPULSE_QWEN_MAX_INPUT_TOKENS=4096
CITYPULSE_BACKEND_HOST=127.0.0.1
CITYPULSE_BACKEND_PORT=8000
CITYPULSE_BACKEND_URL=http://127.0.0.1:8000

# Keep this 0 so the launcher never silently adopts an old manually-started
# service. Set to 1 only when an external supervisor intentionally owns both
# processes and you have checked their effective configuration yourself.
CITYPULSE_ALLOW_UNMANAGED_SERVICES=0
